Grammar

    0 $accept: input $end

    1 input: statement_list

    2 statement_list: statement_list statement
    3               | statement

    4 statement: declaration
    5          | ID '=' expression ';'
    6          | IF '(' condition ')' statement
    7          | IF '(' condition ')' statement ELSE statement
    8          | WHILE '(' condition ')' statement
    9          | '{' statement_list '}'

   10 declaration: type identifier_list ';'

   11 type: INT
   12     | FLOAT
   13     | CHAR

   14 identifier_list: ID
   15                | identifier_list ',' ID

   16 condition: condition OR condition_and
   17          | condition_and

   18 condition_and: condition_and AND condition_not
   19              | condition_not

   20 condition_not: '!' condition_not
   21              | '(' condition ')'
   22              | expression relop expression

   23 relop: '<'
   24      | '>'
   25      | LE
   26      | GE
   27      | NE
   28      | EQ

   29 expression: expression '+' term
   30           | expression '-' term
   31           | term

   32 term: term '*' factor
   33     | term '/' factor
   34     | factor

   35 factor: '(' expression ')'
   36       | ID
   37       | NUMBER


